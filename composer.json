{
    "name": "tobento/app-user",
    "version": "2.0.1",
    "type": "library",
    "description": "User support for the app with authentication and authorization.",
    "keywords": [
        "tobento",
        "package",
        "app",
        "user",
        "authentication",
        "authorization",
        "roles",
        "permissions",
        "acl"
	],
    "homepage": "https://www.tobento.ch",
    "license": "MIT",
    "authors": [
        {
            "name": "Tobias Strub",
            "email": "info@tobento.ch",
            "homepage": "https://www.tobento.ch"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": ">=8.4",
        "tobento/app": "^2.0",
        "tobento/app-migration": "^2.0",
        "tobento/app-http": "^2.0",
        "tobento/app-database": "^2.0",
        "tobento/app-validation": "^2.0",
        "tobento/app-country": "^2.0",
        "tobento/service-config": "^2.0",
        "tobento/service-user": "^2.0",
        "tobento/service-acl": "^2.0",
        "tobento/service-clock": "^2.0",
        "tobento/service-repository": "^2.0",
        "tobento/service-repository-storage": "^2.0"
    },  
    "require-dev": {
        "phpunit/phpunit": "^12.3",
        "vimeo/psalm": "^6.13",
        "nyholm/psr7": "^1.8",
        "tobento/app-console": "^2.0",
        "tobento/app-event": "^2.0",
        "tobento/service-console": "^2.0",
        "tobento/service-container": "^2.0",
        "mockery/mockery": "^1.6"
    },
    "autoload": {
        "psr-4": {
            "Tobento\\App\\User\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tobento\\App\\User\\Test\\": "tests",
            "Tobento\\App\\Http\\Test\\": "vendor/tobento/app-http/tests",
            "Tobento\\Service\\Console\\Test\\": "vendor/tobento/service-console/tests"
        }
    },
    "scripts": {
        "test": "phpunit --testdox --colors=always",
        "psalm": "vendor/bin/psalm"
    }
}